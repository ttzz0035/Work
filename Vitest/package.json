{
  "name": "fuxa-script-test",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "lint": "eslint \"targets/**/*.js\"",
    "docs:flow": "node tools/generate-docs.mjs",
    "docs:api": "jsdoc -r docs/jsdoc-src -d docs/api",
    "docs:test": "node tools/generate-test-docs.mjs && jsdoc framework.cjs tests tools -r -c jsdoc.config.json -d docs/test/api",
    "docs": "npm run docs:flow && npm run docs:api",
    "quality": "node tools/quality.mjs"
  },
  "devDependencies": {
    "@babel/generator": "^7.28.0",
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@eslint/js": "^10.0.1",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "js2flowchart": "^1.3.5",
    "jsdoc": "^4.0.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "axios": "^1.20.0"
  }
}